
QWidget {
    background-color: #f3f6fb;
    color: #202b3e;
    font-family: Arial;
    font-size: 13px;
}

QLabel#title {
    color: #233b67;
    font-size: 26px;
    font-weight: bold;
}

QPushButton {
    background-color: #315da8;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px;
}

QPushButton:hover {
    background-color: #244981;
}

QPushButton:pressed {
    background-color: #19365f;
}
